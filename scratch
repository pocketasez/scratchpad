#!/usr/bin/env python
import base64
import bisect
import glob
import itertools
import json
import lzma
import os
import re
import subprocess
import sys
import time
import unicodedata
import zlib

BLANK, DWELL, END = 0.2, 0.7, 2.0
ABC = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
TOKEN = (
    r'[{}\[\],:]|"[^"\\]*(?:\\.[^"\\]*)*"'
    r"|-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?|true|false|null"
)
NON_ASCII = r"[^\x00-\x7f]"
SAMPLE = "".join(chr(c) for c in range(32, 127))
FLAGS = ("--plain", "--no-ignore")


def main() -> None:
    sys.stdout.reconfigure(encoding="utf-8")
    cols, lines = term_size()
    width = cols - 6
    args = sys.argv[1:]
    plain = "--plain" in args
    everything = "--no-ignore" in args
    names = files([a for a in args if a not in FLAGS], everything)
    if not names:
        sys.exit("no files matched; pass globs, e.g. 'src/**/*.py'")
    folds = [("glyphs.txt", fold("t", [SAMPLE[:48], SAMPLE[48:]], "glyphs.txt", 48))]
    for name in names:
        folds.append((name, fold_file(name, width, plain)))
    for name, rows in folds:
        widest = max(cells(r) for r in rows)
        if widest > width + 4:
            sys.exit(f"{name}: a row is {widest} cells, over {width + 4}; not drawn")
    draw(folds, cols, lines)


def fold_text(name: str, width: int) -> list[str]:
    return fold("t", read_lines(name), name, width)


def fold_json(name: str, width: int, plain: bool = False) -> list[str]:
    try:
        with open(name, encoding="utf-8") as fh:
            mini = json.dumps(json.load(fh), separators=(",", ":"))
    except ValueError as e:
        sys.exit(f"{name}: not JSON ({e}); not drawn")
    ends = list(itertools.accumulate(map(len, re.findall(TOKEN, mini))))
    lines, start = [], 0
    while start < len(mini):
        i = bisect.bisect_right(ends, start + width) - 1
        end = ends[i] if i >= 0 and ends[i] > start else start + width
        lines.append(mini[start:end])
        start = end
    if "".join(lines) != mini:
        sys.exit(f"{name}: fold is not lossless; not drawn")
    as_json = fold("j", lines, name, width)
    if plain:
        return as_json
    return min(as_json, fold_compressed(name, width, mini), key=len)


def fold(kind: str, lines: list[str], name: str, width: int) -> list[str]:
    text = ("" if kind == "j" else "\n").join(lines)
    head = f"#{kind}1 {len(lines)} {zlib.crc32(text.encode()):08x} {name}"
    return rows_of(head, lines, width)


def fold_compressed(name: str, width: int, text: str | None = None) -> list[str]:
    if text is None:
        text = "\n".join(read_lines(name))
    packed = lzma.compress(text.encode(), preset=9 | lzma.PRESET_EXTREME)
    blob = base64.a85encode(packed).decode()
    chunks = [blob[i : i + width] for i in range(0, len(blob), width)] or [""]
    lines = len(text.split("\n")) if text else 0
    head = f"#z1 {lines} {zlib.crc32(text.encode()):08x} {name}"
    return rows_of(head, chunks, width)


def fold_packed(name: str, width: int) -> list[str]:
    lines = read_lines(name)
    sep = separator("\n".join(lines))
    if sep is None:
        say(f"{name}: holds every printable character; drawn a line per row")
        return fold("t", lines, name, width)
    packed = sep.join(lines)
    chunks = [packed[i : i + width] for i in range(0, len(packed), width)] or [""]
    crc = zlib.crc32("\n".join(lines).encode())
    return rows_of(f"#c1{sep} {len(lines)} {crc:08x} {name}", chunks, width)


def draw(folds: list[tuple[str, list[str]]], cols: int, lines: int) -> None:
    out = sys.stdout
    out.write("\033[?25l")
    try:
        for page, screen in enumerate(screens(folds, cols, lines), 1):
            if page > 1:
                time.sleep(DWELL)
            out.write("\033[3J\033[H\033[2J")
            out.flush()
            time.sleep(BLANK)
            out.write(f"=== [SLIDE {page:04d}] {'=' * 50}\n{screen}")
            out.flush()
        time.sleep(END)
    finally:
        out.write("\033[?25h\n")
        out.flush()


def screens(folds: list[tuple[str, list[str]]], cols: int, lines: int) -> list[str]:
    done, rows, used = [], [], 1
    for name, fold in folds:
        for row in ["", f"<<<FILE: {name}>>>", *fold]:
            row += "¶\n"
            n = (len(row) - 2) // (cols - 1) + 1
            if used > 1 and used + n > lines - 2:
                done.append("".join(rows))
                rows, used = [], 1
            rows.append(row)
            used += n
    return [*done, "".join(rows)]


def files(patterns: list[str], everything: bool = False) -> list[str]:
    found = set()
    for pattern in patterns:
        matched = {
            f.replace(os.sep, "/")
            for expanded in braces(pattern)
            for f in glob.glob(expanded, recursive=True)
            if os.path.isfile(f)
        }
        if not matched:
            say(f"{pattern}: matched nothing")
        found |= matched
    if not everything and (skipped := ignored(found)):
        say(f"{len(skipped)} gitignored file(s) not drawn; --no-ignore draws them")
        found -= skipped
    return sorted(found, key=lambda f: f.split("/"))


def term_size() -> tuple[int, int]:
    if os.environ.get("COLS") and os.environ.get("LINES"):
        return int(os.environ["COLS"]), int(os.environ["LINES"])
    if os.name == "nt":
        os.system("")
    try:
        size = os.get_terminal_size()
        return size.columns, size.lines
    except OSError:
        cols = subprocess.run(["tput", "cols"], capture_output=True).stdout
        lines = subprocess.run(["tput", "lines"], capture_output=True).stdout
        return int(cols), int(lines)


def fold_file(name: str, width: int, plain: bool = False) -> list[str]:
    if name.endswith(".json"):
        return fold_json(name, width, plain)
    if plain:
        return fold_text(name, width)
    if name.endswith((".csv", ".tsv")):
        return fold_data(name, width)
    return fold_smallest(name, width)


def fold_smallest(name: str, width: int) -> list[str]:
    return min(fold_text(name, width), fold_compressed(name, width), key=len)


def fold_data(name: str, width: int) -> list[str]:
    return min(
        fold_text(name, width),
        fold_packed(name, width),
        fold_compressed(name, width),
        key=len,
    )


def rows_of(head: str, lines: list[str], width: int) -> list[str]:
    rows = []
    for ln in [head, *lines]:
        pieces = [ln[i : i + width] for i in range(0, len(ln), width)] or [""]
        rows += [f"{check('+' + p)}+{p}" for p in pieces[:-1]]
        rows.append(f"{check(pieces[-1])}|{pieces[-1]}")
    return rows


def read_lines(name: str) -> list[str]:
    with open(name, "rb") as fh:
        data = fh.read()
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        text = data.decode("cp1252", errors="replace")
        say(f"{name}: not UTF-8, read as Windows-1252; it comes back as UTF-8")
    lines = [ln.rstrip("\r").expandtabs(4) for ln in text.split("\n")]
    if lines[-1] == "":
        lines.pop()
    wide = "".join(sorted(c for c in set(re.findall(NON_ASCII, text)) if cells(c) > 1))
    if wide:
        say(f"{name}: double-width {wide}; those rows will not read back")
    return lines


def separator(text: str) -> str | None:
    held = set(text)
    for c in "~`^!#$%&*+;?@=<>()[]{}'\"\\/:,.-_":
        if c not in held:
            return c
    return None


def check(chunk: str) -> str:
    n = zlib.crc32(chunk.encode()) & 0x7FFF
    return ABC[n >> 10] + ABC[(n >> 5) & 31] + ABC[n & 31]


def cells(s: str) -> int:
    if s.isascii():
        return len(s)
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def braces(pattern: str) -> list[str]:
    i = pattern.find("{")
    if i < 0:
        return [pattern]
    depth = 0
    for j in range(i, len(pattern)):
        depth += (pattern[j] == "{") - (pattern[j] == "}")
        if depth == 0:
            break
    else:
        return [pattern]
    parts, depth, start = [], 0, i + 1
    for k in range(i + 1, j):
        depth += (pattern[k] == "{") - (pattern[k] == "}")
        if pattern[k] == "," and depth == 0:
            parts.append(pattern[start:k])
            start = k + 1
    parts.append(pattern[start:j])
    if len(parts) == 1:
        return [pattern[: j + 1] + rest for rest in braces(pattern[j + 1 :])]
    return [
        out for part in parts for out in braces(pattern[:i] + part + pattern[j + 1 :])
    ]


def ignored(names: set[str]) -> set[str]:
    if not names:
        return set()
    try:
        done = subprocess.run(
            ["git", "check-ignore", "--stdin", "-z"],
            input="\0".join(names).encode(),
            capture_output=True,
        )
    except OSError:
        return set()
    if done.returncode != 0:
        return set()
    return {n.replace(os.sep, "/") for n in done.stdout.decode().split("\0") if n}


def say(msg: str) -> None:
    sys.stderr.write(msg + "\n")


if __name__ == "__main__":
    main()
